<% layout('layout') %>
<% title = 'Witaj w Mniamcal' %>

<div class="hero">
    <h1 class="hero-title">Planuj posiłki ze znajomymi</h1>
    <p class="hero-subtitle">Oszczędzaj pieniądze i czas z Mniamcal</p>
    
    <div class="hero-actions">
        <a href="/register" class="btn btn-primary">Rozpocznij za darmo</a>
        <a href="/login" class="btn btn-secondary">Zaloguj się</a>
    </div>
</div>

<div class="features">
    <div class="feature-card">
        <div class="feature-icon">👨‍👩‍👧‍👦</div>
        <h3>Twórz rodzinę</h3>
        <p>Zaproś znajomych lub współlokatorów i planujcie posiłki razem.</p>
    </div>
    
    <div class="feature-card">
        <div class="feature-icon">📅</div>
        <h3>Planuj z wyprzedzeniem</h3>
        <p>Kalendarz posiłków pomoże Ci zorganizować każdy tydzień.</p>
    </div>
    
    <div class="feature-card">
        <div class="feature-icon">🛒</div>
        <h3>Listy zakupów</h3>
        <p>Automatycznie generowane listy na podstawie zaplanowanych posiłków.</p>
    </div>
</div>